modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "holiday-golf-carts-financing"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "holiday-golf-carts-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "holiday-golf-carts-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "holiday-golf-carts-format"

[[workflows.workflow]]
name = "holiday-golf-carts-financing"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/holiday-golf-carts test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "holiday-golf-carts-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/holiday-golf-carts build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "holiday-golf-carts-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/holiday-golf-carts typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "lint"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run lint"

[[workflows.workflow]]
name = "holiday-golf-carts-format"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/holiday-golf-carts format:check"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
